        <title>Jujutsu: Managing workspaces</title>
        <published>2026-02-08T19:09:42+05:30</published>
        <updated>2026-02-08T19:09:42+05:30</updated>
        
        <author>
          <name>
            
              Pavan Sunkara
            
          </name>
        </author>
        
        <link rel="alternate" type="text/html" href="https://pksunkara.com/tech-notes/jujutsu-managing-workspaces/"/>
